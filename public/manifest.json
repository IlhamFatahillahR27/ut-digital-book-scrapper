{
  "manifest_version": 3,
  "name": "RBV-UT to PDF Exporter",
  "short_name": "RBV-UT PDF",
  "version": "1.1.0",
  "description": "Ekspor Buku Materi Pokok (BMP) digital Kotobee Universitas Terbuka menjadi satu file PDF vektor utuh yang bersih dan searchable.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rbv-ut-pdf-exporter@ut-helper.mozilla",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://univterbuka.kotobee.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://univterbuka.kotobee.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RBV-UT to PDF Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://univterbuka.kotobee.com/*"
      ]
    }
  ]
}
