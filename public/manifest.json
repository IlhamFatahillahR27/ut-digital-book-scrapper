{
  "manifest_version": 3,
  "name": "RBV-UT to PDF Exporter",
  "short_name": "RBV-UT PDF",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Ekspor Buku Materi Pokok (BMP) digital Kotobee Universitas Terbuka menjadi satu file PDF utuh terstruktur dengan bookmarks.",
  "permissions": [
    "debugger",
    "downloads",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://univterbuka.kotobee.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://univterbuka.kotobee.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RBV-UT to PDF Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://univterbuka.kotobee.com/*"
      ]
    }
  ]
}
