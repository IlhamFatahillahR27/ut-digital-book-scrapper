{
  "name": "rbv-ut-to-pdf-exporter",
  "version": "1.0.0",
  "private": true,
  "description": "Mozilla Firefox Add-on (Manifest V3) to export UT Kotobee digital books into structured searchable PDFs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "tsc --noEmit && node scripts/build.js",
    "type-check": "tsc --noEmit",
    "lint:amo": "addons-linter dist",
    "test:assembler": "node scripts/run-ts-test.js scripts/test-pdf-assembler.ts",
    "test:resilience": "node scripts/run-ts-test.js scripts/test-fase5-resilience.ts",
    "package": "npm run build && npm run lint:amo && node scripts/package.js",
    "verify:package": "node scripts/package.js --verify-only"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^22.13.9",
    "addons-linter": "^10.16.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
