{
  "name": "rbv-ut-to-pdf-exporter",
  "version": "1.1.0",
  "private": true,
  "description": "Microsoft Edge / Chrome Extension to export UT Kotobee digital books into structured PDFs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "tsc --noEmit && node scripts/build.js",
    "type-check": "tsc --noEmit",
    "test:toc": "node scripts/run-ts-test.js scripts/test-toc-selection.ts",
    "package": "npm run build && node scripts/package.js",
    "verify:package": "node scripts/package.js --verify-only"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
